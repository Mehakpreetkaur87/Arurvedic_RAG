###############################################################################
# Ayurveda RAG System - Environment Configuration
# Copy this file to .env and fill in your actual values
###############################################################################

# ============================================================================
# GOOGLE GEMINI API CONFIGURATION
# ============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
# Steps:
# 1. Go to Google AI Studio (makersuite.google.com)
# 2. Click "Get API key"
# 3. Create a new API key
# 4. Copy and paste below
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# LLM CONFIGURATION (Primary & Fallback)
# ============================================================================
# PRIMARY_LLM: Main LLM provider to use first
# Options: "gemini" (Google API), "ollama" (Local)
PRIMARY_LLM=gemini

# FALLBACK_LLM: LLM to use if primary fails
# Options: "ollama" (Local), "gemini" (Google API)
FALLBACK_LLM=ollama

# OLLAMA_BASE_URL: Endpoint for local Ollama service
# Default: http://localhost:11434
# Change if Ollama runs on different machine/port
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# LLM GENERATION PARAMETERS
# ============================================================================
# MAX_TOKENS: Maximum tokens in LLM response
# Range: 500-4000 (higher = longer responses)
# Note: Gemini has limits (depends on model)
# Recommendation: 2000
MAX_TOKENS=2000

# TEMPERATURE: Response creativity level
# Range: 0.0 (deterministic) to 1.0 (creative)
# 0.0 = Always same answer
# 0.7 = Balanced (default)
# 1.0 = Very creative/random
# Recommendation: 0.7 for medical context
TEMPERATURE=0.7

# TOP_P: Nucleus sampling (alternative to temperature)
# Range: 0.0 to 1.0
# Lower = More focused, Higher = More diverse
# Recommendation: 0.9
TOP_P=0.9

# ============================================================================
# EMBEDDING & VECTOR SEARCH CONFIGURATION
# ============================================================================
# EMBEDDING_MODEL: Model for converting text to vectors
# Recommended for 8GB RAM:
# - "sentence-transformers/all-MiniLM-L6-v2" (384 dims, fast, ~90MB)
# - "sentence-transformers/all-MiniLM-L12-v1" (384 dims, slower, ~120MB)
# Other options:
# - "sentence-transformers/all-mpnet-base-v2" (768 dims, better, ~430MB)
# Note: First run will download model (~500MB+)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RERANKER_MODEL: Cross-encoder for reranking results
# Recommended:
# - "cross-encoder/ms-marco-MiniLM-L-6-v2" (lightweight, fast)
# - "cross-encoder/mmarco-mMiniLMv2-L12-H384-V1" (multilingual)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# DEVICE: Computing device for embeddings
# Options: "cpu" (slower, low memory), "cuda" (fast, requires GPU)
# Recommendation: "cpu" for 8GB systems
DEVICE=cpu

# ============================================================================
# RETRIEVAL PARAMETERS - TUNING
# ============================================================================
# BM25_TOP_K: Number of results from BM25 keyword search
# Range: 5-50
# Higher = More candidates, slower, more comprehensive
# Recommendation: 20
BM25_TOP_K=20

# VECTOR_TOP_K: Number of results from vector/semantic search
# Range: 5-50
# Higher = More candidates, slower, more comprehensive
# Recommendation: 20
VECTOR_TOP_K=20

# RERANK_TOP_K: Final number of results after reranking
# Range: 3-10
# This is what gets passed to LLM as context
# Recommendation: 5 (keeps context size reasonable)
RERANK_TOP_K=5

# RRF_K: RRF fusion parameter
# Formula: 1/(k + rank)
# Higher k = Less difference between ranks
# Recommendation: 60 (standard)
RRF_K=60

# SIMILARITY_THRESHOLD: Minimum similarity score to include (0.0-1.0)
# 0.0 = No filtering
# 0.5 = Only moderately similar or higher
# Recommendation: 0.3 (filter low-quality results)
SIMILARITY_THRESHOLD=0.3

# ============================================================================
# DATABASE & STORAGE CONFIGURATION
# ============================================================================
# DB_PATH: SQLite database for chat history
# Location for storing conversations
DB_PATH=data/chat_history.db

# VECTOR_DB_PATH: Directory for FAISS vector indices
# Will store: vector index, metadata, BM25 pickle
VECTOR_DB_PATH=data/faiss_index

# METADATA_PATH: JSON file for chunk metadata
# Stores original document info, region names, etc.
METADATA_PATH=data/metadata.json

# ============================================================================
# DATA LOADING & PROCESSING
# ============================================================================
# KNOWLEDGE_BASE_PATH: Directory containing source files
# Supports: .json (structured) and .txt (unstructured)
KNOWLEDGE_BASE_PATH=data/knowledge_base

# CHUNK_SIZE: Characters per chunk for embedding
# Larger = Better context, slower processing
# Smaller = Faster, may split important info
# Recommendation: 500-1000
CHUNK_SIZE=800

# CHUNK_OVERLAP: Characters overlapped between chunks
# Helps maintain context across chunks
# Recommendation: CHUNK_SIZE / 4 (200)
CHUNK_OVERLAP=200

# ============================================================================
# SYSTEM & OPTIMIZATION
# ============================================================================
# BATCH_SIZE: Items processed together
# Larger = Faster for large datasets, more memory
# Smaller = Lower memory usage
# Recommendation: 8-32
BATCH_SIZE=16

# CACHE_ENABLED: Enable query caching
# True = Faster repeated queries, uses more disk
# False = Always fresh answers, slower
CACHE_ENABLED=true

# CACHE_EXPIRY_HOURS: How long to cache results
# Recommendation: 24 (1 day)
CACHE_EXPIRY_HOURS=24

# ENABLE_SIMILAR_QUERY_DETECTION: Find & reuse similar past queries
# True = Faster on repeated topics, uses more disk
# False = Always process fresh
ENABLE_SIMILAR_QUERY_DETECTION=true

# ============================================================================
# LOGGING & DEBUG
# ============================================================================
# LOG_LEVEL: Logging verbosity
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG = Lots of details (slow), useful for troubleshooting
# INFO = General info (default)
# ERROR = Only errors
LOG_LEVEL=INFO

# DEBUG_MODE: Enable detailed debugging
# True = Print detailed processing steps, slower
# False = Normal mode
DEBUG_MODE=false

# ============================================================================
# TEXT NORMALIZATION (Version 2.0 Feature)
# ============================================================================
# ENABLE_NORMALIZATION: Normalize IAST text
# True = "AGNIMĀNDYA" → "AGNIMANDYA" (v2.0)
# False = Exact matching only (v1.0)
# Note: v1.0 works in production, v2.0 is experimental
ENABLE_NORMALIZATION=false

# NORMALIZATION_TYPE: How to normalize text
# Options: "iast_to_ascii", "remove_diacritics", "both"
NORMALIZATION_TYPE=both

# ============================================================================
# STREAMING & REAL-TIME
# ============================================================================
# ENABLE_STREAMING: Stream LLM responses in real-time
# True = Show response as it's generated (better UX)
# False = Wait for complete response
ENABLE_STREAMING=true

# STREAM_CHUNK_SIZE: Size of response chunks in streaming
# Smaller = More frequent updates, smoother UX
# Larger = Less overhead, might seem jerky
STREAM_CHUNK_SIZE=50

# ============================================================================
# API RATE LIMITING
# ============================================================================
# GEMINI_REQUESTS_PER_MINUTE: Rate limit for Gemini API
# Free tier limit: 15 requests/minute
# Paid tier: Higher (check Google pricing)
GEMINI_REQUESTS_PER_MINUTE=15

# OLLAMA_TIMEOUT_SECONDS: Timeout for Ollama responses
# Increase if using large models on slow hardware
OLLAMA_TIMEOUT_SECONDS=120

# ============================================================================
# STREAMLIT UI CONFIGURATION
# ============================================================================
# STREAMLIT_THEME: UI theme
# Options: "light", "dark"
STREAMLIT_THEME=dark

# MAX_CHAT_HISTORY_DISPLAY: How many past messages to show
# Higher = More memory usage, full context visible
# Recommendation: 20-50
MAX_CHAT_HISTORY_DISPLAY=30

# ============================================================================
# ADVANCED TUNING (Expert Only)
# ============================================================================
# Enable experimental features
EXPERIMENTAL_FEATURES=false

# Use approximate nearest neighbor for FAISS (faster, less accurate)
FAISS_USE_APPROXIMATE=false

# Number of parallel workers for processing
N_WORKERS=1

###############################################################################
# IMPORTANT NOTES:
# 1. Do NOT commit .env to git (add to .gitignore)
# 2. Keep GEMINI_API_KEY secret - never share
# 3. For 8GB RAM: Keep DEVICE=cpu, don't increase BM25/VECTOR top-k
# 4. First run will download ~1-2GB of models
# 5. Change CHUNK_SIZE if getting out-of-memory errors
# 6. See README.md for detailed parameter explanations
###############################################################################
